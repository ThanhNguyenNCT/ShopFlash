# Docker Compose
COMPOSE_PROJECT_NAME=shopflash

# Oracle
# Mật khẩu: bắt đầu bằng chữ cái, chỉ gồm chữ, số và _ (dùng trong connect string không có dấu nháy).
# ORACLE_ADMIN_PASSWORD chỉ container Oracle dùng; backend và Flyway dùng ORACLE_APP_PASSWORD (user SHOP).
ORACLE_HOST=localhost
ORACLE_PORT=1521
# Cố định, không đổi: script khởi tạo, healthcheck và quyền đều dùng FREEPDB1 và user SHOP.
ORACLE_DATABASE=FREEPDB1
ORACLE_SCHEMA=SHOP
ORACLE_ADMIN_PASSWORD=ChangeMe_OracleAdmin1
ORACLE_APP_PASSWORD=ChangeMe_Shop1

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ChangeMe_Redis1
REDIS_DATABASE=0
